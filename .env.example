# ============================================
# MISAN BOT - ENVIRONMENT EXAMPLE
# ============================================
# Copy this file to .env and fill in your values

DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_PUBLIC_KEY=your_public_key_here
BOT_OWNER_ID=your_discord_user_id_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/misan
JWT_SECRET=change_this_to_a_random_secret_string_at_least_32_chars
NEXT_PUBLIC_BOT_NAME=Misan
NEXT_PUBLIC_BOT_INVITE=https://discord.com/oauth2/authorize?client_id=YOUR_ID&permissions=8&scope=bot%20applications.commands
NEXT_PUBLIC_SUPPORT_SERVER=https://discord.gg/your-server-here
NEXT_PUBLIC_WEBSITE_URL=https://misanbot.app
NODE_ENV=development
